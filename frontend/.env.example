# Copy to .env to change these for your machine. .env is never committed.

# Where the Vite dev server forwards /api (dev only; never sent to the browser).
# Phase 2: product-service. From Phase 3: the api-gateway, http://localhost:8080
API_PROXY_TARGET=http://localhost:8082

# Base URL the browser uses for API calls. Empty = same origin ("/api/..."), which goes through the proxy above.
VITE_API_BASE_URL=
