# Copy to .env (git-ignored) and change values if needed.
# Without a .env file, docker-compose.yml falls back to these same local-dev defaults.

MYSQL_ROOT_PASSWORD=root
MYSQL_PASSWORD=stockline
MYSQL_PORT=3306
KAFKA_PORT=9092
KAFKA_UI_PORT=8090

# Host ports of the service containers (docker compose --profile services up -d)
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
PRODUCT_SERVICE_PORT=8082

# Web addresses whose pages may call the api-gateway from a browser (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Token signing key (at least 32 characters; auth-service and the api-gateway use the same one) and token lifetime
JWT_SECRET=local-dev-only-stockline-jwt-secret-change-me
JWT_EXPIRATION=8h
# The first ADMIN account, created only when auth_db.users is empty
ADMIN_EMAIL=admin@stockline.local
ADMIN_PASSWORD=admin12345
