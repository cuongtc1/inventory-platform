# Copy to .env (git-ignored) and change values if needed.
# Without a .env file, docker-compose.yml falls back to these same local-dev defaults.

MYSQL_ROOT_PASSWORD=root
MYSQL_PASSWORD=stockline
MYSQL_PORT=3306
KAFKA_PORT=9092
KAFKA_UI_PORT=8090

# Host ports of the service containers (docker compose --profile services up -d)
PRODUCT_SERVICE_PORT=8082
